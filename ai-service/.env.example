# Copy this file to .env and fill in real values. Never commit .env.
# Placeholder values only — never put a real key in this file.

# Port the service listens on (contract default: 4000).
PORT=4000

# Your Gemini API key. Leave empty to run unconfigured: /ai/health will
# report configured: false and /ai/analyze will return available: false.
GEMINI_API_KEY=

# Model name. gemini-2.0-flash is an example from the contract, not a
# guarantee: verify the model is currently supported in your Gemini API
# account at build time and set this to that model. The service still
# starts with any model string; an unavailable model surfaces as
# available: false on first call, not a startup crash.
GEMINI_MODEL=gemini-2.0-flash

# Optional shared secret for /ai/analyze. When set, callers must send it as
# X-AI-Service-Key. The backend sends it from its own AI_SERVICE_KEY env var.
# Leave empty for local dev only; always set it on a public deploy.
AI_SERVICE_KEY=

# Rate limit for /ai/analyze (per IP).
AI_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_WINDOW_MS=900000

# Bound on the rate-limit bucket map itself (distinct IPs). At the cap
# the oldest bucket is evicted. Default 5000.
AI_RATE_LIMIT_MAX_ENTRIES=5000

# Maximum simultaneous Gemini calls. Over the cap, /ai/analyze answers
# available: false immediately instead of queueing. Default 5.
AI_MAX_CONCURRENT=5
